# Next.js is the published listener and always uses port 3000 (`next start -p 3000`).
# The loopback FHIR proxy uses FHIR_PROXY_PORT (default 3001). Do not publish it.
# PORT is ignored by both processes so a platform value cannot collide the two.
FHIR_PROXY_PORT=3001
FHIR_MODE=local
FHIR_PROXY_URL=http://127.0.0.1:3001
FHIR_BASE_URL=https://fhir.medblocks.com/fhir/YOUR_TENANT_ID
FHIR_AUTH_TOKEN=
CLINICAL_VAULT_EN_PATH=vault-en
CLINICAL_VAULT_ES_PATH=vault-es
# Required. At least 32 characters. Do not reuse the old example value.
# Generate: openssl rand -base64 48
SESSION_SECRET=
# Shared by the Next.js server and the loopback FHIR proxy. Same generation command.
FHIR_PROXY_SECRET=
CLINICAL_AI_KEY=
CLINICAL_AI_BASE=https://openrouter.ai/api/v1
CLINICAL_AI_MODEL=openai/gpt-4o
# Comma-separated hostnames. The consult proxy refuses any other host.
CLINICAL_AI_HOST_ALLOWLIST=openrouter.ai

# Password reset. In production SMTP_HOST and MAIL_FROM are required to deliver mail.
# If they are missing, startup logs a warning, the request still answers the same way,
# and the link is not logged. Assign a password with the hidden prompt or one stdin line:
#   npm run set-password -- <correo>
# Do not put the password in the environment or in argv. SET_PASSWORD is ignored.
# Behind Dokploy/Traefik, set TRUST_PROXY=1 so the change-password limiter uses
# X-Real-IP or the last X-Forwarded-For hop. Without it those headers are ignored.
# Local only: uncomment the flag below to print the link in the Next.js console.
# The flag is ignored when NODE_ENV=production.
# Gmail: turn on 2-Step Verification, then create an App Password. That is SMTP_PASS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
# Public origin used to build the reset link, without a trailing slash.
# Production requires https. If it is missing or not https, no reset token is created.
APP_BASE_URL=http://localhost:3000
# TRUST_PROXY=1
# Directory that stores accounts.json. Default: data/auth
# INTEGRAMED_AUTH_ROOT=data/auth
# Directory of the local FHIR JSON store. Default: data/fhir
# INTEGRAMED_FHIR_ROOT=data/fhir
# PASSWORD_RESET_LOG_LINK=1
