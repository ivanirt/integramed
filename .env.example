PORT=3001
FHIR_MODE=local
FHIR_PROXY_URL=http://127.0.0.1:3001
FHIR_BASE_URL=https://fhir.medblocks.com/fhir/YOUR_TENANT_ID
FHIR_AUTH_TOKEN=
CLINICAL_VAULT_EN_PATH=vault-en
CLINICAL_VAULT_ES_PATH=vault-es
# Required. At least 32 characters. Do not reuse the old example value.
# Generate: openssl rand -base64 48
SESSION_SECRET=
# Shared by the Next.js server and the loopback FHIR proxy. Same generation command.
FHIR_PROXY_SECRET=
CLINICAL_AI_KEY=
CLINICAL_AI_BASE=https://openrouter.ai/api/v1
CLINICAL_AI_MODEL=openai/gpt-4o
# Comma-separated hostnames. The consult proxy refuses any other host.
CLINICAL_AI_HOST_ALLOWLIST=openrouter.ai

# Password reset. In production SMTP_HOST and MAIL_FROM are required to deliver mail.
# If they are missing, startup logs a warning, the request still answers the same way,
# and the link is not logged. Assign a password with:
#   SET_PASSWORD='…' npm run set-password -- <email>
# Local only: uncomment the flag below to print the link in the Next.js console.
# The flag is ignored when NODE_ENV=production.
# Gmail: turn on 2-Step Verification, then create an App Password. That is SMTP_PASS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
# Public origin used to build the reset link, without a trailing slash.
APP_BASE_URL=http://localhost:3000
# PASSWORD_RESET_LOG_LINK=1
