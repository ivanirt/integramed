PORT=3001
FHIR_MODE=local
FHIR_PROXY_URL=http://localhost:3001
FHIR_BASE_URL=https://fhir.medblocks.com/fhir/YOUR_TENANT_ID
FHIR_AUTH_TOKEN=YOUR_BEARER_TOKEN
CLINICAL_VAULT_EN_PATH=vault-en
CLINICAL_VAULT_ES_PATH=vault-es
SESSION_SECRET=integramed-dev-session-secret
CLINIC_MASTER_PASSWORD=IntegraMed27
CLINICAL_AI_KEY=
CLINICAL_AI_BASE=https://openrouter.ai/api/v1
CLINICAL_AI_MODEL=openai/gpt-4o

# Correo para restablecer contraseña. En local puedes dejar SMTP vacío:
# el enlace se imprime en la consola del proceso web (npm run dev), no en el proxy FHIR.
# Gmail: activa la verificación en dos pasos y crea una contraseña de aplicación
# (Cuenta de Google → Seguridad → Verificación en dos pasos → Contraseñas de aplicaciones).
# SMTP_HOST=smtp.gmail.com  SMTP_PORT=587
# SMTP_USER y MAIL_FROM = la cuenta Gmail que envía (por ejemplo ivanirt@gmail.com)
# SMTP_PASS = la contraseña de aplicación de 16 caracteres, no la contraseña normal de Google.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
# Origen público para armar el enlace del correo, sin barra final.
APP_BASE_URL=http://localhost:3000
