{
  "name": "integramed-clinic",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.6.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "test": "node --experimental-strip-types --test tests/*.test.mjs test/*.test.ts",
    "dev:fhir": "node server/index.js",
    "dev:web": "node ./node_modules/next/dist/bin/next dev --turbopack -p 3000",
    "build": "node ./node_modules/next/dist/bin/next build",
    "start": "concurrently --kill-others --success first -n fhir,web \"npm run start:fhir\" \"node ./node_modules/next/dist/bin/next start -p 3000\"",
    "start:fhir": "node server/index.js",
    "lint": "eslint",
    "create-user": "node --experimental-strip-types scripts/create-user.ts",
    "set-password": "node --experimental-strip-types scripts/set-password.ts",
    "seed:test-users": "node --experimental-strip-types scripts/seed-test-users.ts",
    "remove-test-users": "node --experimental-strip-types scripts/remove-test-users.ts"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "concurrently": "^9.1.2",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "next": "^15.5.25",
    "nodemailer": "^10.0.14",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.25",
    "tailwindcss": "^4.3.3",
    "typescript": "^5"
  }
}
